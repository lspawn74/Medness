<Window x:Class="DialogueStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DialogueStudio"
        mc:Ignorable="d"
        Title="MainWindow" Height="900" Width="1600"
        Background="Black">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <!-- Buttons bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Name="LoadButton"
                Content="Load"
                Click="LoadButton_Click"/>
            <Button
                Grid.Column="1"
                Name="SaveButton"
                Content="Save"
                Click="SaveButton_Click"/>
            <Button
                Grid.Column="2"
                Name="InsertButton"
                Content="Insert"
                Click="InsertButton_Click"/>
        </Grid>
        
        <!-- Dialogues list -->
        <Grid
            Grid.Row="1"
            Margin="0,10,0,0">
            <ListView
                Foreground="Black"
                ItemsSource="{Binding DialogueItems}"
                SelectedItem="{Binding SelectedDialogue}"
                SelectedIndex="{Binding SelectedIndex}">
                <ListView.View>
                    <GridView AllowsColumnReorder="false">
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Id}" Header="Id" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Character}" Header="Character" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Text}" Header="Text" Width="300"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=DataFile}" Header="DataFile" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=DialogueTrigger.Type}" Header="Trigger type" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=DialogueTrigger.Object}" Header="Trigger object" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
