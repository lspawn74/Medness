        <mxCell id="I5zgXSvpNAoJsuCSzfOz-84" value="Achetez en une paire!!. Avec les impôts qu&#39;on nous prélève, votre altesse doit pouvoir se les payer, non ?!" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-40" vertex="1">
