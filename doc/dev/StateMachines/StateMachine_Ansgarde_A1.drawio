        <mxCell id="I5zgXSvpNAoJsuCSzfOz-18" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Quel genre de tord-boyau boivent les gens, par ici ?&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#00FF00;container=0;" parent="1" vertex="1">
