          </mxGeometry>
        </mxCell>
        <mxCell id="1eWn91R5AL2tHRxG5R72-4" value="Je suis un voyageur et j&#39;ai atterri ici et je ne peux pas sortir. Il y a une grille fermée qui m&#39;empêche de sortir.&amp;nbsp;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="qu1pJngNFgtXXQyIwcQS-1" vertex="1">
          <mxGeometry x="-604" y="1130.5" width="200" height="65" as="geometry" />
        </mxCell>
        <mxCell id="1eWn91R5AL2tHRxG5R72-5" value="&lt;font color=&quot;#00ff00&quot;&gt;Comment ça, &quot;atterri&quot; ?!&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#00FF00;container=0;" parent="qu1pJngNFgtXXQyIwcQS-1" vertex="1">
          <mxGeometry x="-604" y="1215.5" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="1eWn91R5AL2tHRxG5R72-6" value="Je ne sais pas. J&#39;étais au labo pour assister le professeur. J&#39;ai pressé le bouton d&#39;une télécommande pour changer la chaîne de télé de l&#39;espace détente et je me suis retrouvé ici." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="qu1pJngNFgtXXQyIwcQS-1" vertex="1">
          <mxGeometry x="-604" y="1260.5" width="200" height="95" as="geometry" />
        </mxCell>
