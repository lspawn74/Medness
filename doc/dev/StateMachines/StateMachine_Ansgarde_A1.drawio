          </mxGeometry>
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-60" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;J&#39;ai pas un kopeck, j&#39;te dis !! C&#39;est la misère, mon pote! Pourquoi tu crois que je bois autant ?&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Allez sois sympa, offre moi un p&#39;tit coup. Au nom de notre amitié !&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#00ff00&quot;&gt;Il te reste bien qulques piécettes, non ? Ça paye bien de veiller sur les morts...&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#00FF00;container=0;" parent="lzvQoto4jdCvMkt3xO3p-1" vertex="1">
