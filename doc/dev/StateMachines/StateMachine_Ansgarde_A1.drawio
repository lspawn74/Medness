          <mxGeometry x="120" y="130" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-58" value="Tu es pénible Héribert ! Tu te fais toujours payer des coups, mais on ne voit jamais la queue d&#39;une tournée de ta part! ... Tu sembles pourtant ne pas être dans le besoin !" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-42" vertex="1">
          <mxGeometry x="50" y="180" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-59" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="adAnRF_k1nkCD7faFfi3-42" source="I5zgXSvpNAoJsuCSzfOz-57" target="I5zgXSvpNAoJsuCSzfOz-58" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="-110" y="400" as="sourcePoint" />
            <mxPoint x="-60" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-60" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;J&#39;ai pas un kopeck, j&#39;te dis !! C&#39;est la misère, mon pote! Pourquoi tu crois que je bois autant ?&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Allez sois sympa, offre moi un p&#39;tit coup. Au nom de notre amitié !&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#00ff00&quot;&gt;Il te reste bien qulques piécettes, non ? Ça paye bien de veiller sur les morts...&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#00FF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-42" vertex="1">
          <mxGeometry x="50" y="280" width="390" height="105" as="geometry" />
