          </mxGeometry>
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-76" value="Vous savez que votre père est un voleur ?" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-40" vertex="1">
          <mxGeometry x="340" y="265" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-78" value="&lt;font style=&quot;color: rgb(0, 255, 0);&quot;&gt;Oui, je sais, il a volé les étoiles du ciel pour les mettre dans mes yeux... pfff... quelle originalité!&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;strokeColor=#00FF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-40" vertex="1">
          <mxGeometry x="340" y="335" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-79" value="Quoi?!&amp;nbsp;&lt;div&gt;Rien à voir !!&lt;/div&gt;&lt;div&gt;Je vous reconnaîs, vous êtes la princesse Ansgarde du royaume de LuyNhuire.&lt;/div&gt;&lt;div&gt;Et votre père, le roi... foutu voleur!!&lt;/div&gt;&lt;div&gt;Vous avez vu le montant de nos impôts ?!&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FFFF00;strokeColor=#FFFF00;container=0;" parent="adAnRF_k1nkCD7faFfi3-40" vertex="1">
          <mxGeometry x="340" y="410" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="I5zgXSvpNAoJsuCSzfOz-80" value="" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="adAnRF_k1nkCD7faFfi3-40" source="I5zgXSvpNAoJsuCSzfOz-76" target="I5zgXSvpNAoJsuCSzfOz-78" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="320" y="245" as="sourcePoint" />
            <mxPoint x="370" y="195" as="targetPoint" />
